# Application
APP_NAME=DocuMind AI
ENV=dev

# Server
HOST=127.0.0.1
PORT=8000

# Uploads
MAX_UPLOAD_SIZE_MB=10

# PostgreSQL (used by docker compose and by the application to build DATABASE_URL)
# These are local development defaults, not real credentials. Change them for any
# shared or production environment and never commit your real .env file.
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5

# Optional: override the connection string used by the application directly.
# If empty, it is built from the POSTGRES_* variables above.
DATABASE_URL=

# Ollama (local inference server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SECONDS=120

# Embedding vector dimension.
# Leave empty until you verify the real dimension of the embedding model with:
#   python scripts/verify_ollama.py
# Migrations refuse to run while this is unset, so no dimension is ever guessed.
EMBEDDING_DIMENSION=

# Version label stored next to each embedding so vectors of different model
# versions can be told apart.
EMBEDDING_VERSION=1

# Retrieval-augmented generation (RAG)
# Text is split into overlapping chunks that never cross a page boundary, so a
# citation always points at a single verifiable page.
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150
# Embeddings are generated in small batches to bound memory use.
EMBEDDING_BATCH_SIZE=8
# Maximum number of chunks retrieved per question.
RETRIEVAL_TOP_K=5
# Minimum cosine similarity for a retrieved chunk to count as evidence.
# This is an initial heuristic, NOT a guarantee of correctness: calibrate it with
# demo/evaluation.json. Raise it to abstain more, lower it to retrieve more.
RETRIEVAL_MIN_SCORE=0.35
# Upper bound on the evidence sent to the language model, in characters.
MAX_CONTEXT_CHARS=6000
MAX_QUESTION_CHARS=1000
